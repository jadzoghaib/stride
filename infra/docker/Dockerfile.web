# Stride web — Vite build served by nginx, /api proxied to the API service
FROM node:22-alpine AS builder
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY apps/web/ .
RUN npm run build

FROM nginx:1.27-alpine
# The nginx image renders /etc/nginx/templates/*.template through envsubst at
# start-up. NGINX_ENVSUBST_FILTER keeps it to STRIDE_* names so nginx's own
# $host / $uri / $request_id are not substituted into emptiness.
COPY infra/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html
ENV NGINX_ENVSUBST_FILTER='^(STRIDE_|PORT$)' \
    STRIDE_API_UPSTREAM='http://api:8490' \
    PORT=80
EXPOSE 80
