# Stride web — rendered at container start by the nginx image's envsubst step.
#
# `${STRIDE_API_UPSTREAM}` is the only substituted value: NGINX_ENVSUBST_FILTER
# in Dockerfile.web restricts substitution to STRIDE_* names, so nginx's own
# `$host`, `$uri` and `$request_id` survive untouched. Without that filter
# envsubst eats them and the proxy headers arrive empty.
#
# Compose sets it to the service name; a hosted deployment sets it to whatever
# internal address the platform gives the API. Nothing about the host is
# compiled in.
server {
    listen ${STRIDE_WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # security headers (SPA). HSTS belongs at the TLS terminator, which on a
    # managed platform is the platform's edge rather than this container.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    # Matches the API's own ceiling (`STRIDE_MAX_UPLOAD_BYTES`, 8 MiB by
    # default) with headroom for the multipart envelope. At the previous 1m,
    # nginx rejected a 5 MB photo with a 413 before the API ever saw it — the
    # upload limit the product documents was not the limit it enforced.
    client_max_body_size 12m;

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API + ops endpoints -> the API service
    location ~ ^/(api|healthz|readyz|metrics) {
        proxy_pass ${STRIDE_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A cold managed instance can take a few seconds to answer its first
        # request; the default 60s read timeout is fine, the connect one is not.
        proxy_connect_timeout 10s;
    }
}
